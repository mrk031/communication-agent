# Copy this file to .env or evaluation/.env and fill values locally.
# .env files are ignored by Git. Never commit real credentials.
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_NAME=通原

# OpenAI-compatible model used only to generate local evaluation questions.
# Base URL normally ends in /v1; never commit the real key.
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=

# End-to-end evaluation against the deployed streaming services.
AGENT_BASE_URL=http://127.0.0.1:9450
E2E_LLM_URL=http://127.0.0.1:9453/chat
E2E_MODEL=GPT
# Fill only after confirming the actual provider/model prices. Currency follows your provider.
E2E_INPUT_PRICE_PER_1M=0
E2E_OUTPUT_PRICE_PER_1M=0
E2E_EMBEDDING_PRICE_PER_1M=0

TEACHER_QA_ES_URL=http://127.0.0.1:9201
TEACHER_QA_ES_INDEX=ctc_discussion1.5
TEACHER_QA_ES_USERNAME=elastic
TEACHER_QA_ES_PASSWORD=

# Agent business services
CTC_URL=http://127.0.0.1:9451/ctc_server
DISCUSSION_URL=http://127.0.0.1:9452/discussion
LLM_URL=http://127.0.0.1:9453/chat
OCR_URL=http://127.0.0.1:9454/ocr_inference
HARDWARE_ARGS_URL=http://127.0.0.1:9455/GetArgs
H5_URL=http://127.0.0.1:9457/H5_server
HARDWARE_URL=http://127.0.0.1:9458/HardWare_server
HISTORY_URL=http://127.0.0.1:8082/ctc_agent/conversations/messages
COURSE_EXPERIMENT_URL=http://127.0.0.1:8001/find_experiments
IDEOLOGY_URL=http://127.0.0.1:8005/search
INTENT_ROUTER_MODE=rules

# Hardware parameter extraction and TCP device endpoint
HARDWARE_LLM_BASE_URL=https://api.openai.com/v1
HARDWARE_LLM_API_KEY=
HARDWARE_LLM_MODEL=gpt-4o-mini
HARDWARE_TCP_HOST=127.0.0.1
HARDWARE_TCP_PORT=9001
